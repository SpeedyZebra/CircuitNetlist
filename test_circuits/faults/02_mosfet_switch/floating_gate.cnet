CIRCUIT Fault_MOSFET_Floating_Gate

COMPONENT V1 POWER_DC_SOURCE voltage=5V
COMPONENT R_LED BASIC_RESISTOR value=220ohm
COMPONENT LED1 LIGHT_LED_RED vf=2.0V current=10mA
COMPONENT Q1 BASIC_NMOS role=low_side_switch

NET VCC:
    V1.POS
    R_LED.1

NET LED_ANODE:
    R_LED.2
    LED1.A

NET LED_SWITCH:
    LED1.K
    Q1.D

NET GND:
    V1.NEG
    Q1.S
