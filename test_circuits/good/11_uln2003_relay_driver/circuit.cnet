CIRCUIT ULN2003_Relay_Driver

COMPONENT VLOGIC POWER_DC_SOURCE voltage=5V
COMPONENT VLOAD POWER_DC_SOURCE voltage=12V
COMPONENT U1 MCU_ARDUINO_NANO_ATMEGA328P_MODULE role=controller
COMPONENT U2 IC_ULN2003_DRIVER_ARRAY role=switch
COMPONENT R_IN BASIC_RESISTOR value=1kohm role=input
COMPONENT RELAY1 BASIC_INDUCTOR value=70mH role=relay_coil
COMPONENT D1 BASIC_DIODE role=flyback
COMPONENT C_LOGIC BASIC_CAPACITOR_CERAMIC value=100nF role=decoupling

NET 5V:
    VLOGIC.POS
    U1.5V
    C_LOGIC.1

NET 12V:
    VLOAD.POS
    RELAY1.1
    D1.K
    U2.COM

NET RELAY_LOW:
    RELAY1.2
    D1.A
    U2.OUT1

NET RELAY_CTRL:
    U1.D3_PWM
    R_IN.1

NET DRIVER_IN:
    R_IN.2
    U2.IN1

NET GND:
    VLOGIC.NEG
    VLOAD.NEG
    U1.GND
    U2.GND
    C_LOGIC.2
