CIRCUIT LM393_Comparator_Hysteresis

COMPONENT V1 POWER_DC_SOURCE voltage=5V
COMPONENT U1 MCU_ARDUINO_NANO_ATMEGA328P_MODULE role=controller
COMPONENT U2 IC_LM393_COMPARATOR role=controller
COMPONENT R_REF_TOP BASIC_RESISTOR value=100kohm
COMPONENT R_REF_BOT BASIC_RESISTOR value=100kohm
COMPONENT R_SENS_TOP BASIC_RESISTOR value=150kohm
COMPONENT R_SENS_BOT BASIC_RESISTOR value=100kohm
COMPONENT R_HYST BASIC_RESISTOR value=1Mohm role=feedback
COMPONENT R_OUT_PULL BASIC_RESISTOR value=10kohm role=pullup
COMPONENT C_DEC BASIC_CAPACITOR_CERAMIC value=100nF role=decoupling

NET 5V:
    V1.POS
    U1.5V
    U2.VCC
    R_REF_TOP.1
    R_SENS_TOP.1
    R_OUT_PULL.1
    C_DEC.1

NET REF:
    R_REF_TOP.2
    R_REF_BOT.1
    U2.INA-
    R_HYST.1

NET SENSE:
    R_SENS_TOP.2
    R_SENS_BOT.1
    U2.INA+

NET COMP_OUT:
    U2.OUTA
    R_OUT_PULL.2
    U1.D5_PWM
    R_HYST.2

NET GND:
    V1.NEG
    U1.GND
    U2.GND
    R_REF_BOT.2
    R_SENS_BOT.2
    C_DEC.2
