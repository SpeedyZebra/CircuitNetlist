CIRCUIT Pico_SPI_ADC

COMPONENT V1 POWER_DC_SOURCE voltage=3.3V
COMPONENT U1 MCU_RASPBERRY_PI_PICO_RP2040_MODULE role=controller
COMPONENT U2 IC_MCP3008_SPI_ADC role=sensor
COMPONENT R_TOP BASIC_RESISTOR value=100kohm
COMPONENT R_BOTTOM BASIC_RESISTOR value=47kohm
COMPONENT C_FILTER BASIC_CAPACITOR_CERAMIC value=10nF role=filter
COMPONENT C_ADC BASIC_CAPACITOR_CERAMIC value=100nF role=decoupling

NET 3V3:
    V1.POS
    U1.3V3
    U2.VDD
    U2.VREF
    R_TOP.1
    C_ADC.1

NET ADC_IN:
    R_TOP.2
    R_BOTTOM.1
    C_FILTER.1
    U2.CH0

NET SPI_SCLK:
    U1.GP2_SCK
    U2.CLK

NET SPI_MOSI:
    U1.GP3_MOSI
    U2.DIN

NET SPI_MISO:
    U1.GP4_MISO
    U2.DOUT

NET SPI_CS:
    U1.GP5_CS
    U2.CS

NET GND:
    V1.NEG
    U1.GND
    U2.AGND
    U2.DGND
    R_BOTTOM.2
    C_FILTER.2
    C_ADC.2
