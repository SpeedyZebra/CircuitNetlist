CIRCUIT WS2812_Level_Shifted_LED_Strip

COMPONENT V1 POWER_DC_SOURCE voltage=5V
COMPONENT UREG1 POWER_LDO_REGULATOR_BLOCK voltage=3.3V role=regulator
COMPONENT U1 MCU_RASPBERRY_PI_PICO_RP2040_MODULE role=controller
COMPONENT U2 IC_UNIDIRECTIONAL_LEVEL_SHIFTER role=controller
COMPONENT R_DATA BASIC_RESISTOR value=330ohm
COMPONENT LEDS1 LIGHT_WS2812_STRIP leds=8 role=load
COMPONENT C_LOGIC BASIC_CAPACITOR_CERAMIC value=100nF role=decoupling
COMPONENT C_BULK BASIC_CAPACITOR_POLARIZED value=1000uF role=bulk

NET 5V:
    V1.POS
    UREG1.VIN
    U2.VCCB
    LEDS1.5V
    C_BULK.POS

NET 3V3:
    UREG1.VOUT
    U1.3V3
    U2.VCCA
    C_LOGIC.1

NET DATA_3V3:
    U1.GP15
    U2.A_IN

NET DATA_5V:
    U2.B_OUT
    R_DATA.1

NET LED_DIN:
    R_DATA.2
    LEDS1.DIN

NET GND:
    V1.NEG
    UREG1.GND
    U1.GND
    U2.GND
    LEDS1.GND
    C_LOGIC.2
    C_BULK.NEG
