CIRCUIT Relay_Flyback_Driver

COMPONENT V1 POWER_DC_SOURCE voltage=12V role=supply
COMPONENT U1 MCU_ATtiny402_SOIC8
COMPONENT L1 BASIC_INDUCTOR value=120mH role=relay_coil
COMPONENT D1 BASIC_DIODE role=flyback
COMPONENT Q1 BASIC_NMOS role=low_side_switch
COMPONENT R_GATE BASIC_RESISTOR value=100ohm role=gate_resistor
COMPONENT R_PULL BASIC_RESISTOR value=100kohm role=pulldown

NET VCC:
    V1.POS
    U1.VDD
    L1.1
    D1.K

NET COIL_SWITCH:
    L1.2
    D1.A
    Q1.D

NET CTRL:
    U1.PA7
    R_GATE.1

NET GATE:
    R_GATE.2
    R_PULL.1
    Q1.G

NET GND:
    V1.NEG
    U1.GND
    R_PULL.2
    Q1.S
