CIRCUIT L293D_Motor_Driver

COMPONENT VLOGIC POWER_DC_SOURCE voltage=5V
COMPONENT VMOTOR POWER_DC_SOURCE voltage=9V
COMPONENT U1 MCU_ARDUINO_NANO_ATMEGA328P_MODULE role=controller
COMPONENT U2 IC_L293D_MOTOR_DRIVER role=controller
COMPONENT MOTOR1 BASIC_INDUCTOR value=20mH role=load
COMPONENT R_EN BASIC_RESISTOR value=10kohm role=pullup
COMPONENT C_LOGIC BASIC_CAPACITOR_CERAMIC value=100nF role=decoupling
COMPONENT C_BULK BASIC_CAPACITOR_POLARIZED value=100uF role=bulk

NET 5V:
    VLOGIC.POS
    U1.5V
    U2.VLOGIC
    R_EN.1
    C_LOGIC.1

NET MOTOR_SUPPLY:
    VMOTOR.POS
    U2.VMOTOR
    C_BULK.POS

NET MOTOR_ENABLE:
    R_EN.2
    U2.EN1

NET MOTOR_IN1:
    U1.D3_PWM
    U2.IN1

NET MOTOR_IN2:
    U1.D5_PWM
    U2.IN2

NET MOTOR_A:
    U2.OUT1
    MOTOR1.1

NET MOTOR_B:
    U2.OUT2
    MOTOR1.2

NET GND:
    VLOGIC.NEG
    VMOTOR.NEG
    U1.GND
    U2.GND
    C_LOGIC.2
    C_BULK.NEG
