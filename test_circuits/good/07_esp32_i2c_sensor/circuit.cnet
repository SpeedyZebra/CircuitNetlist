CIRCUIT ESP32_I2C_Sensor

COMPONENT V1 POWER_DC_SOURCE voltage=5V
COMPONENT UREG1 POWER_LDO_REGULATOR_BLOCK voltage=3.3V role=regulator
COMPONENT U1 MCU_ESP32_DEVKIT_MODULE role=controller
COMPONENT SENS1 MODULE_I2C_SENSOR_BME280 role=sensor
COMPONENT R_SDA BASIC_RESISTOR value=4.7kohm role=pullup
COMPONENT R_SCL BASIC_RESISTOR value=4.7kohm role=pullup
COMPONENT R_EN BASIC_RESISTOR value=10kohm role=pullup
COMPONENT C_REG BASIC_CAPACITOR_CERAMIC value=1uF role=decoupling
COMPONENT C_ESP BASIC_CAPACITOR_CERAMIC value=100nF role=decoupling

NET 5V:
    V1.POS
    UREG1.VIN

NET 3V3:
    UREG1.VOUT
    U1.3V3
    SENS1.VCC
    R_SDA.1
    R_SCL.1
    R_EN.1
    C_REG.1
    C_ESP.1

NET ESP32_EN:
    R_EN.2
    U1.EN

NET I2C_SDA:
    U1.GPIO21_SDA
    SENS1.SDA
    R_SDA.2

NET I2C_SCL:
    U1.GPIO22_SCL
    SENS1.SCL
    R_SCL.2

NET GND:
    V1.NEG
    UREG1.GND
    U1.GND
    SENS1.GND
    C_REG.2
    C_ESP.2
