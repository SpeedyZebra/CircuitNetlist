CIRCUIT Multi_Decoupling_With_RC_Filters

COMPONENT V8 POWER_DC_SOURCE voltage=5V
COMPONENT U22 MCU_ATtiny402_SOIC8
COMPONENT C29 BASIC_CAPACITOR_CERAMIC value=100nF
COMPONENT C41 BASIC_CAPACITOR_CERAMIC value=1uF
COMPONENT C7 BASIC_CAPACITOR_CERAMIC value=10uF role=bulk
COMPONENT C63 BASIC_CAPACITOR_POLARIZED value=1000uF role=reservoir
COMPONENT R3 BASIC_RESISTOR value=1kohm
COMPONENT C54 BASIC_CAPACITOR_CERAMIC value=100nF
COMPONENT R81 BASIC_RESISTOR value=2.2kohm
COMPONENT C12 BASIC_CAPACITOR_CERAMIC value=220nF

NET VDD:
    V8.POS
    U22.VDD
    C29.1
    C41.1
    C7.1
    C63.POS
    R3.1
    R81.1

NET FILTER_A:
    R3.2
    C54.1
    U22.PA6

NET FILTER_B:
    R81.2
    C12.1
    U22.PA7

NET GND:
    V8.NEG
    U22.GND
    C29.2
    C41.2
    C7.2
    C63.NEG
    C54.2
    C12.2
